# Files that must never be copied into the Docker image.
# Secrets are passed to the container at runtime via `env_file: .env`
# in docker-compose.yml, so the image itself never contains them.

# Secrets
.env
.env.*
**/.env
**/.env.*

# Local Python environments and caches (rebuilt inside the image)
.venv/
venv/
__pycache__/
**/__pycache__/
*.pyc
